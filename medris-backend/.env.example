# medris-backend environment. Copy to .env for local development; in
# production set these in the Vercel project settings. Never commit real values.
# Every variable is validated at start-up (src/config/app-config.ts); a
# production build fails if a required one is missing (scripts/check-deploy-env.mjs).

# ------------------------------------------------------------------ runtime
# development | test | production
NODE_ENV=development
# debug | info | warn | error  (logs are JSON lines; secrets are redacted)
LOG_LEVEL=info
# Requests to /api/v1 are cut off after this many milliseconds
REQUEST_TIMEOUT_MS=25000

# ----------------------------------------------------------------- database
# REQUIRED. Standard PostgreSQL connection string; the API reads and writes
# the database only through this connection (no Supabase REST calls).
# Supabase today: Project Settings -> Database -> Connection pooling,
# "Transaction" mode (port 6543). Local: see docs/DATABASE.md.
#   postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Connections per process. Serverless: keep it small (1-3); every instance has its own pool.
DATABASE_POOL_MAX=3
# require (encrypted) | verify-full (encrypted + certificate check, set DATABASE_SSL_CA) | disable (local only)
DATABASE_SSL_MODE=require
# PEM text of the provider's CA certificate (use \n for line breaks) for verify-full
DATABASE_SSL_CA=
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
# Optional: the database `npm run db:migrate` / `db:status` work on (defaults to DATABASE_URL).
# Must be a session-mode connection (Supabase session pooler or direct, port 5432), never 6543.
# Applying to a remote database also needs --confirm <host> (docs/DATABASE.md, section 3).
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
MIGRATE_DATABASE_URL=
# Optional: live updates (/api/v1/live) LISTEN for row changes on this connection. Must be session mode
# (direct or session pooler, port 5432) - the transaction pooler (6543) drops notifications. Needs migration 0009.
# Unset: the live socket still works for typing/presence/calls, but no row changes are pushed.
LIVE_DATABASE_URL=

# ------------------------------------------------------- Supabase Auth/Storage
# Supabase stays the identity provider and private-file store for now.
# The service-role key is server-only (Auth admin API, Storage).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Access tokens are verified locally: with the project's signing keys
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json) for asymmetric keys, or with
# this legacy JWT secret for HS256 projects. Without either, HS256 tokens are
# checked with Supabase's /auth/v1/user as before.
SUPABASE_JWT_SECRET=
# Defaults to <SUPABASE_URL>/auth/v1 and "authenticated"
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# --------------------------------------------- backend-managed sessions (OFF)
# Built and tested but NOT enabled in production until approved: needs
# migration 0002 applied first (docs/AUTH.md).
AUTH_BACKEND_SESSIONS=false
AUTH_SESSION_TTL_DAYS=30
AUTH_SESSION_IDLE_DAYS=14
AUTH_COOKIE_NAME=medris_session
# Must stay true outside local http:// development
AUTH_COOKIE_SECURE=true
# Extra origins (besides APP_ORIGIN) allowed to make cookie-authenticated changes
AUTH_TRUSTED_ORIGINS=
# Backend "Sign in with Google" (only with backend sessions). Redirect URI:
# https://<app-origin>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------------- limits
# Per-instance request limits on sensitive endpoints (sign-in, writes)
RATE_LIMIT_ENABLED=true

# --------------------------------------------------------------- API docs
# Swagger UI at /api/v1/docs and the OpenAPI document at /api/v1/openapi.json.
# Unset: on in development/test, off with NODE_ENV=production. They describe
# the API only (no data, no configuration values).
# API_DOCS_ENABLED=true

# ---------------------------------------------------------- other services
# Must equal the secret embedded in the database functions that call /api/notify
# (notify_email_on_notification, ring_callee_again, send_background_reminders).
EMAIL_WEBHOOK_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=

# Resend e-mail. EMAIL_FROM is optional (defaults to Resend's shared sender).
RESEND_API_KEY=
EMAIL_FROM=

# Web push (VAPID). The public key defaults to the live key; it must match the frontend's VITE_VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Google Gemini (Levi)
GEMINI_API_KEY=

# Shared secret for /api/daily-cron (Vercel Cron) and /api/order-reminders (GitHub Actions)
CRON_SECRET=

# Cloudflare R2 (public images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional Cloudinary for images (inactive unless IMAGE_STORAGE=cloudinary; docs/STORAGE.md)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=levromart
IMAGE_STORAGE=r2

# Optional TURN servers for calls, tried in this order, then the shared Open Relay
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
METERED_API_KEY=
METERED_DOMAIN=

# Optional: origin used in e-mail / push links (default https://levromart.vercel.app)
APP_ORIGIN=
# Optional: origin serving /api/notif-icon, used for push-notification pictures (default https://levromart.com)
ICON_ORIGIN=
# Optional: comma-separated browser origins allowed to call the API cross-origin
# (only needed when the frontend is served from a different origin than /api).
CORS_ALLOWED_ORIGINS=
# Optional: folder with the web app's static files (built index.html, fonts, og-frame.png, icons)
# used for link previews, share cards and notification pictures. Defaults to
# medris-frontend/dist, falling back to medris-frontend/public for images and fonts.
STATIC_ASSETS_DIR=

# Local dev server port and graceful-shutdown grace period
PORT=8787
SHUTDOWN_GRACE_MS=10000
